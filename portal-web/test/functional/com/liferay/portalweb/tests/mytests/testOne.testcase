@component-name = "portal-lima"
definition {

	property portal.acceptance = "true";
	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Blogs";

	setUp {
		task ("Faz login no site") {
			TestCase.setUpPortalInstance();

			User.firstLoginPG();
		}

		task (" adiciona um layout de blog ao site") {
			JSONLayout.addPublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");

			JSONLayout.addWidgetToPublicLayout(
				column = "1",
				groupName = "Guest",
				layoutName = "Blogs Page",
				widgetName = "Blogs");
		}

		task ("Vai para a pagina de blogs e adiciona uma entrada de blog") {
			Navigator.gotoPage(pageName = "Blogs Page");

			Blogs.addEntry(
				entryContent = "Blogs Entry Content1",
				entryTitle = "Blogs Entry Title1");
		}
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			Blogs.tearDownConfigurationDisplaySettingsPG(
				pageName = "Blogs Page",
				portletName = "Blogs");

			JSONLayout.deletePublicLayout(
				groupName = "Guest",
				layoutName = "Blogs Page");
		}
	}

	test CanSearchBlogs {
		task ("Adiciona uma pagina de blog e navega ate a blogs page") {
			Blogs.addEntry(
				entryContent = "Blogs Entry Content2",
				entryTitle = "Blogs Entry Title2");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("Procura pela entrada 1 e verifica o resultado encontrado") {
			SearchPortlets.searchEmbedded(searchTerm = "&quot;Blogs Entry Title1&quot;");

			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "Blogs Entry Title1",
				searchAssetType = "Blogs Entry",
				searchTerm = "&quot;Blogs Entry Title1&quot;");
		}

		task ("vai para a pagina blogs page e procura pela entrada 3") {
			Navigator.gotoPage(pageName = "Blogs Page");

			SearchPortlets.searchEmbedded(searchTerm = "&quot;Blogs Entry Title3&quot;");
		}

		task ("verifica resultado que nao exite") {
			SearchResultPortlet.viewNoSearchResults(searchTerm = "&quot;Blogs Entry Title3&quot;");
		}
	}

}